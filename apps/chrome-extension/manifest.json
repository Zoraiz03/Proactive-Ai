{
  "manifest_version": 3,
  "name": "Proactive AI IDE — Selected Text Preview",
  "version": "0.1.0",
  "description": "Preview text you explicitly select before a future confirmed transfer to Proactive AI IDE.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "action": {
    "default_title": "Preview selected text",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}

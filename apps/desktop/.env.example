# Public Supabase client configuration only. Never place service-role or provider keys here.
DESKTOP_SUPABASE_URL=https://your-project.supabase.co
DESKTOP_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-or-anon-key
# HTTPS URL of the deployed Next.js backend. Local HTTP is allowed only for localhost.
DESKTOP_API_BASE_URL=http://127.0.0.1:3000
